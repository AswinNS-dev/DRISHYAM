# ============================================================
# DRISHYAM – root .gitignore
# ============================================================

# ── Environment / secrets ────────────────────────────────────
.env
.env.*
!.env.example        # keep the example templates

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ── Runtime data / user uploads ──────────────────────────────
backend/storage/
*.bin

# ── Scratch / throwaway files ────────────────────────────────
scratch/

# ── Stray lockfiles outside package roots ────────────────────
backend/app/package-lock.json

# ── SQLite database files ─────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Node / npm ────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite build output
frontend/dist/
frontend/.vite/

# TypeScript build cache
*.tsbuildinfo

# ── OS artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log

# ── Misc ─────────────────────────────────────────────────────
.cache/
tmp/
temp/
