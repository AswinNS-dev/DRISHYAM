# --- Leave all SUPABASE_* blank to run on local SQLite automatically ---
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- AI provider: template | groq | gemini | openai ---
# "template" (default) needs no key and gives fully evidence-grounded,
# deterministic answers. Set a provider + its key to use a real LLM.
AI_PROVIDER=template
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

JWT_SECRET=change-this-in-production
AUTO_SEED=true
ENV=development
